<trans-unit id="s0b1690024b09098d">
  <source>📨 Almost there! We sent you a confirmation email. Check spam folder if you don't see it.</source>
  <target>📨 Prawie gotowe! Wysłaliśmy Ci e-mail w celu potwierdzenia. Jeśli nie możesz go znaleźć, sprawdź folder ze spamem.</target>
</trans-unit>
<trans-unit id="s06de85f5e3de8fb2">
